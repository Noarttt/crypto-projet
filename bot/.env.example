# Copie ce fichier en .env sur le serveur (jamais commité, jamais collé dans le chat).

# RPC Solana : clé Helius gratuite (https://dashboard.helius.dev). Sans clé, le RPC public est utilisé (très limité).
HELIUS_API_KEY=

# Optionnel : clé PumpPortal. Le flux des migrations est gratuit et marche sans clé.
PUMPPORTAL_API_KEY=

# Optionnel : dossier des données (par défaut bot/data)
# DATA_DIR=/var/lib/defi-bot
